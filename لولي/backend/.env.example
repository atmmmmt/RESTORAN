PORT=3002
MONGODB_URI=mongodb://localhost:27017/luliz
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development
TZ=Asia/Damascus

# Frontend origins allowed by CORS. Multiple origins may be comma-separated.
FRONTEND_URL=http://localhost:5173

# Luliz is the safe default for this deployment.
DEFAULT_TENANT=luliz
# host=tenant pairs, comma-separated.
TENANT_HOSTS=loliz-taste.com=luliz,www.loliz-taste.com=luliz

# The seed wipes data for the selected tenant. Keep disabled by default.
ALLOW_DESTRUCTIVE_SEED=false
SEED_TENANT=luliz
