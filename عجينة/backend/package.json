{
  "name": "luliz-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "menu:assets": "node src/seed/syncLegacyMenuAssets.js",
    "menu:check": "node src/seed/importLegacyMenu.js --dry-run",
    "menu:import": "node src/seed/importLegacyMenu.js",
    "menu:nutrition": "node src/seed/enrichLegacyNutrition.js",
    "inventory:migrate-branches": "node src/seed/migrateBranchInventory.js",
    "test:acceptance": "node test/acceptance.e2e.js",
    "menu:migrate": "npm run menu:assets && npm run menu:import",
    "categories:migrate": "node src/seed/migrateCategories.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "zkteco-js": "^1.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
