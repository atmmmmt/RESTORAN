PORT=3002
MONGODB_URI=mongodb://localhost:27017/ajeena
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development
TZ=Asia/Damascus

# Frontend origins allowed by CORS. Multiple origins may be comma-separated.
FRONTEND_URL=http://localhost:5173

# The seed wipes the current database. Keep disabled by default.
ALLOW_DESTRUCTIVE_SEED=false

# إدارة الأميركان — the Ajeena backend reads both databases from the same
# MongoDB server and exposes only the scoped, read-only management dashboard.
LULIZ_DB_NAME=luliz
# Optional explicit center IDs. Leave blank to auto-detect a center containing
# "الأميركان" / "اميركان" / "American". If only one active center exists it is used.
AMERICANS_AJEENA_CENTER_ID=
AMERICANS_LULIZ_CENTER_ID=

# Restricted central management login.
# Keep the password only in the deployment environment; never commit it.
AMERICANS_MANAGER_NAME=إدارة الأميركان
AMERICANS_MANAGER_EMAIL=americans@restoran.local
AMERICANS_MANAGER_PASSWORD=

# WhatsApp Cloud API (Meta for Developers) — optional notifications.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
