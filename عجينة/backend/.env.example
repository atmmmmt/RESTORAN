PORT=3002
MONGODB_URI=mongodb://localhost:27017/ajeena
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development
TZ=Asia/Damascus

# Frontend origins allowed by CORS. Multiple origins may be comma-separated.
FRONTEND_URL=http://localhost:5173

# The seed wipes the current database. Keep disabled by default.
ALLOW_DESTRUCTIVE_SEED=false

# WhatsApp Cloud API (Meta for Developers) — optional notifications.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
