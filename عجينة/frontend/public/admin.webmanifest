{
  "id": "/admin",
  "name": "لوحة تحكم عجينة وطحينة",
  "short_name": "إدارة عجينة",
  "description": "لوحة تحكم المطعم — الطلبات والكاشير والمطبخ والحضور والرواتب.",
  "start_url": "/admin/dashboard?source=pwa",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "dir": "rtl",
  "lang": "ar",
  "background_color": "#FBF7F0",
  "theme_color": "#352017",
  "categories": ["business", "productivity", "food"],
  "icons": [
    { "src": "/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "الكاشير", "short_name": "الكاشير", "url": "/admin/pos", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "شاشة المطبخ", "short_name": "المطبخ", "url": "/admin/kitchen", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "الحضور والبصمة", "short_name": "الحضور", "url": "/admin/attendance", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "الطلبات", "short_name": "الطلبات", "url": "/admin/orders", "icons": [{ "src": "/pwa/icon-192.png", "sizes": "192x192" }] }
  ]
}
